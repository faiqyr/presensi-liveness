# ==========================================
# Copy file ini menjadi .env lalu isi dengan kredensial Anda
# cp .env.example .env
# ==========================================

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=ubah_password_anda_disini
DB_HOST=localhost
DB_PORT=5432
DB_NAME=presensi_db

# Atau gunakan full URI (override semua setting di atas)
# DATABASE_URL=postgresql://username:password@host:5432/dbname

# Flask Secret Key (generate random: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_random_key_here
